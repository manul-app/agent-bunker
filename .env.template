# Comma-separated list of project directories to mount into the container
# Defaults to ~/projects if not set. E.g.: ~/projects, ~/work, ~/experiments
PROJECTS_DIRS=~/projects

# Allow or block access to host machine and local databases (true/false)
# When set to false, all connections to host.docker.internal, local DBs, and private networks are blocked
ALLOW_LOCAL_DB_ACCESS=true

# GitLab configuration (optional)
# GITLAB_USER=oauth2
GITLAB_TOKEN=
