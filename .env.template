# Comma-separated list of project directories to mount into the container
# Defaults to ~/projects if not set. E.g.: ~/projects, ~/work, ~/experiments
PROJECTS_DIRS=~/projects

# Allow or block access to host machine and local databases (true/false)
# When set to false, all connections to host.docker.internal, local DBs, and private networks are blocked
ALLOW_LOCAL_DB_ACCESS=true

# GitLab configuration (optional)
# GITLAB_USER=oauth2
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# xAI API key for Grok CLI (optional). If unset, Grok prompts to sign in on first `bunker-x`.
XAI_API_KEY=


# Container resource limits (optional, all have sane defaults)
# BUNKER_MEMORY=8g          # hard RAM ceiling; container is OOM-killed past this
# BUNKER_MEMORY_SWAP=10g    # RAM + swap combined; set equal to BUNKER_MEMORY to disable swap
# BUNKER_CPUS=4             # CPU quota; throttles runaway loops, does not kill them
# BUNKER_PIDS=4096          # max processes; stops fork bombs from eating the host PID space
# BUNKER_SHM=1g             # /dev/shm size; Docker's 64m default is too small for Chromium
